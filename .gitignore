# ============================================================
# KARMIQ — .gitignore
# ============================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.local

# Node dependencies
node_modules/
package-lock.json.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Code Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary / Scratch files & AI cache
.gemini/
.agents/
.cache/
tmp/
temp/
